generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LessonModule {
  SPEAKING
  LISTENING
  READING
  WRITING
  VOCABULARY
  GRAMMAR
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ConversationMode {
  TEXT
  VOICE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum Accent {
  AMERICAN
  BRITISH
}

enum ExplanationMode {
  ENGLISH_ONLY
  ENGLISH_THAI
}

enum VocabularySource {
  OXFORD_3000
  OXFORD_5000
  TOEIC
  GOVERNMENT_EXAM
  BUSINESS_ENGLISH
  DAILY_ENGLISH
  AI_GENERATED
}

enum VocabularyReviewStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum ExamCategory {
  CEFR
  TOEIC
  GOVERNMENT_EXAM
  TEACHER_ASSISTANT
  GRAMMAR
  VOCABULARY
  READING
}

enum ExamMode {
  PRACTICE
  EXAM
}

enum ExamStatus {
  DRAFT
  READY
  ARCHIVED
}

model User {
  id                String                  @id @default(cuid())
  name              String?
  email             String?                 @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  accounts          Account[]
  sessions          Session[]
  learningProfile   LearningProfile?
  teacherPreference TeacherPreference?
  lessonProgress    LessonProgress[]
  conversations     Conversation[]
  speakingSessions  SpeakingSession[]
  userVocabulary    UserVocabulary[]
  grammarMistakes   GrammarMistake[]
  exams             Exam[]
  examAttempts      ExamAttempt[]
  dailyProgress     DailyLearningProgress[]
  apiUsageLogs      APIUsageLog[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LearningProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  level               CEFRLevel @default(A1)
  dailyStudyMinutes   Int       @default(15)
  learningStreak      Int       @default(0)
  totalStudyMinutes   Int       @default(0)
  onboardingCompleted Boolean   @default(false)
  weakTopics          String[]  @default([])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherPreference {
  id              String          @id @default(cuid())
  userId          String          @unique
  teacherName     String          @default("Alex")
  personality     String          @default("encouraging")
  accent          Accent          @default(AMERICAN)
  explanationMode ExplanationMode @default(ENGLISH_THAI)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String?
  module      LessonModule
  level       CEFRLevel
  content     Json
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  progress    LessonProgress[]

  @@index([module, level])
  @@index([published])
}

model LessonProgress {
  id           String               @id @default(cuid())
  userId       String
  lessonId     String
  status       LessonProgressStatus @default(NOT_STARTED)
  score        Int?
  minutesSpent Int                  @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model Conversation {
  id               String            @id @default(cuid())
  userId           String
  title            String            @default("New conversation")
  mode             ConversationMode  @default(TEXT)
  startedAt        DateTime          @default(now())
  endedAt          DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         ChatMessage[]
  speakingSessions SpeakingSession[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id               String       @id @default(cuid())
  conversationId   String
  role             MessageRole
  content          String
  correctedText    String?
  thaiExplanation  String?
  metadata         Json?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SpeakingSession {
  id              String        @id @default(cuid())
  userId          String
  conversationId  String?
  scenario        String
  durationSeconds Int           @default(0)
  transcript      String?
  audioBlobPath   String?
  feedback        Json?
  score           Int?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Vocabulary {
  id              String           @id @default(cuid())
  word            String           @unique
  partOfSpeech    String?
  ipa             String?
  translationTh   String
  definition      String?
  exampleSentence String?
  exampleThai     String?
  synonyms        String[]         @default([])
  antonyms        String[]         @default([])
  collocations    String[]         @default([])
  source          VocabularySource @default(AI_GENERATED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userVocabulary  UserVocabulary[]

  @@index([source])
}

model UserVocabulary {
  id             String                 @id @default(cuid())
  userId         String
  vocabularyId   String
  status         VocabularyReviewStatus @default(NEW)
  dueAt          DateTime               @default(now())
  repetitions    Int                    @default(0)
  intervalDays   Int                    @default(0)
  easeFactor     Float                  @default(2.5)
  lastReviewedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary             @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@index([userId, dueAt])
  @@index([userId, status])
}

model GrammarMistake {
  id              String    @id @default(cuid())
  userId          String
  topic           String
  sourceText      String
  correctedText   String
  explanationTh   String?
  occurrenceCount Int       @default(1)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic])
  @@index([userId, resolvedAt])
}

model Exam {
  id               String         @id @default(cuid())
  userId           String?
  title            String
  category         ExamCategory
  level            CEFRLevel
  mode             ExamMode       @default(PRACTICE)
  questionCount    Int
  timeLimitSeconds Int?
  status           ExamStatus     @default(READY)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions        ExamQuestion[]
  attempts         ExamAttempt[]

  @@index([userId, createdAt])
  @@index([category, level])
}

model ExamQuestion {
  id            String       @id @default(cuid())
  examId        String
  order         Int
  prompt        String
  options       Json
  correctOption Int
  explanations  Json?
  createdAt     DateTime     @default(now())
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       ExamAnswer[]

  @@unique([examId, order])
  @@index([examId])
}

model ExamAttempt {
  id          String       @id @default(cuid())
  userId      String
  examId      String
  score       Int?
  total       Int
  startedAt   DateTime     @default(now())
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers     ExamAnswer[]

  @@index([userId, createdAt])
  @@index([examId])
}

model ExamAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption Int?
  isCorrect      Boolean?
  createdAt      DateTime     @default(now())
  attempt        ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model DailyLearningProgress {
  id                 String   @id @default(cuid())
  userId             String
  date               DateTime @db.Date
  studyMinutes       Int      @default(0)
  lessonsCompleted   Int      @default(0)
  speakingMinutes    Int      @default(0)
  vocabularyReviewed Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model APIUsageLog {
  id               String   @id @default(cuid())
  userId           String?
  provider         String   @default("groq")
  model            String
  endpoint         String
  requestId        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  statusCode       Int
  errorCode        String?
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([endpoint, createdAt])
}
